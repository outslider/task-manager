# HTTPS で公開する場合のリバースプロキシ設定例
# 併せて config.ini の [server] secure_cookie = 1 を設定してください。
server {
    listen 443 ssl http2;
    server_name tasks.example.co.jp;

    ssl_certificate     /etc/letsencrypt/live/tasks.example.co.jp/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tasks.example.co.jp/privkey.pem;

    # 添付ファイルの上限に合わせる（既定 25MB）
    client_max_body_size 30m;

    location / {
        proxy_pass         http://127.0.0.1:8080;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

server {
    listen 80;
    server_name tasks.example.co.jp;
    return 301 https://$host$request_uri;
}

# ---------------------------------------------------------------------------
# サブディレクトリ（例 https://example.co.jp/tasks/）で公開する場合
#
# アプリ側の config.ini に base_path = /tasks を設定し、
# プロキシではプレフィックスを "削らない" 形にします（proxy_pass の末尾に / を付けない）。
# 逆に proxy_pass の末尾に / を付けて nginx 側で削る場合は、base_path は空のままにします。
# 1 つのドメインで複数のアプリを相乗りさせるときに使います。
# ---------------------------------------------------------------------------
