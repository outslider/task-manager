; タスク管理システム 設定ファイル
; このファイルを config.ini にコピーして環境に合わせて編集してください。
; 同じ項目を環境変数で指定した場合は、環境変数が優先されます。

[database]
host = 127.0.0.1
port = 3306
name = task_manager
user = tmapp
password = ここにパスワード

[server]
; 0.0.0.0 で全インターフェース待ち受け。リバースプロキシ配下なら 127.0.0.1 を推奨。
host = 0.0.0.0
port = 8080
; 添付ファイル1件あたりの上限（バイト）。既定 25MB
max_upload_bytes = 26214400
; HTTPS で公開する場合は 1 にする（セッション Cookie に Secure 属性を付与）
secure_cookie = 0
